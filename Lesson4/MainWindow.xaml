<Window x:Class="Lesson4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Name="Result" Text="Количество очков: 0"/>
            
            <StackPanel>
                <TextBlock Text="Дата Крещение Руси: "/>
                <RadioButton GroupName="FirstQuestion" Content="1000 г."/>
                <RadioButton GroupName="FirstQuestion" Content="1200 г."/>
                <RadioButton Name="FirstQuestionCorrectAnswer" GroupName="FirstQuestion" Content="988 г."/>
                <RadioButton GroupName="FirstQuestion" Content="987 г."/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Какие города есть в России?"/>
                <CheckBox Name="SecondQuestionCorrectAnswer1" Content="Москва"/>
                <CheckBox Name="SecondQuestionCorrectAnswer2" Content="Омск"/>
                <CheckBox Name="SecondQuestionNotCorrectAnswer1" Content="Минс"/>
                <CheckBox Name="SecondQuestionCorrectAnswer3" Content="Воронеж"/>
            </StackPanel>

            <Button Content="Проверить" Click="Button_Check_Answers"/>
        </StackPanel>
    </Grid>
</Window>
