<Window x:Class="Lesson1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson1"
        mc:Ignorable="d"
        Title="Главное окно" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Height="30" Orientation="Horizontal">
                <TextBlock Width="50" Text="Ответ: "/>
                <TextBlock Width="130" Name="resultTextBlock" />
            </StackPanel>
            <StackPanel Height="30" Orientation="Horizontal">
                <TextBlock Width="30" Text="a = "/>
                <TextBox Name="aTextBox" Width="150" />
            </StackPanel>
            <StackPanel Height="30" Orientation="Horizontal">
                <TextBlock Width="30" Text="b = "/>
                <TextBox Name="bTextBox" Width="150" />
            </StackPanel>
            <StackPanel Height="30" Orientation="Horizontal">
                <TextBlock Width="30" Text="c = "/>
                <TextBox Name="cTextBox" Width="150" />
            </StackPanel>

            <Button Content="Решить" Height="30" Width="180" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
