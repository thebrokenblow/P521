<Window x:Class="Lesson3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" Height="30" Text="Имя"/>
                <TextBox Name="FirstName" Height="30" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" Height="30" Text="Фамилия"/>
                <TextBox Name="LastName" Height="30" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" Height="30" Text="Отчество"/>
                <TextBox Name="MiddleName" Height="30" Width="150"/>
            </StackPanel>
            <StackPanel>
                <CheckBox Name="IsSubscribeOnNotification" Content="Подписываюсь на групповую рассылку" />
                <CheckBox Name="IsAgreementForPersonalData" Content="Соглаcен на обработку персональных данных" IsChecked="True" />
            </StackPanel>
            <Button Click="Button_Save_Data" Content="Сохранить" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
